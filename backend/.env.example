# ------------------------------------------------------------------
# Copy to .env and fill in. Integrations without credentials run in
# mock/disabled mode so the app works end-to-end in local dev.
# ------------------------------------------------------------------

# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/idjobsite

# Auth / JWT  (generate a strong secret for anything beyond local dev)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis / arq
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (MinIO in local dev)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=id-jobsite
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PRESIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_SIZE_MB=50

# LLM (provider-agnostic). Leave as 'mock' until you have a provider.
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL=

# WhatsApp Business Cloud API (disabled until configured)
WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Google Calendar OAuth (optional until wired)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
